# Copy to studio\.env and fill in. Never commit .env.

# ── Folders ───────────────────────────────────────────────────────────────────
# Where the worker keeps the library, catalogue and logs (default: %USERPROFILE%\Studio)
STUDIO_ROOT=
# Where the phone's uploads land: the OneDrive folder, usually
#   C:\Users\<you>\OneDrive\Studio Inbox
# (Google Drive for desktop works too: G:\My Drive\Studio Inbox)
# Blank = %USERPROFILE%\Studio\Inbox
STUDIO_INBOX=

# ── Claude ────────────────────────────────────────────────────────────────────
# From console.anthropic.com (the same key the bot uses works)
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
STUDIO_CLAUDE_MODEL=claude-opus-5-5
STUDIO_CLAUDE_EFFORT=medium
# How hard Studio thinks when it reads a draft for problems (low/medium/high/xhigh/max). High: about US$0.20-0.40 more per draft.
STUDIO_READ_EFFORT=high

# ── AI concept images for carousels (optional; README section 12) ─────────────
# A Google AI Studio key (aistudio.google.com > Get API key, with billing on). On the
# server, put it in with: ssh -t root@<server> bash /home/studio/personal_assistant/studio/server/setup.sh key gemini
# Blank = no concept pictures (the planner says "needs the image key").
GEMINI_API_KEY=
# Optional overrides (defaults shown): the image model and what one picture costs (US$)
STUDIO_IMAGE_MODEL=gemini-nano-banana-2.1
STUDIO_IMAGE_COST_USD=0.034

# ── Epidemic Sound (music for the editor) ─────────────────────────────────────
# Personal MCP key: epidemicsound.com/account/api-keys
EPIDEMIC_SOUND_API_KEY=
# Accounts allowed to use Epidemic music: personal and/or urban_makers, comma-separated.
# Your plan covers one channel per platform, so list only the Instagram account you've
# connected in Epidemic Sound. Others get edits without Epidemic music.
STUDIO_MUSIC_ACCOUNTS=urban_makers

# Review plays a light 720p copy of each draft and clip (starts at once, no stops on slow wifi).
# 0 = no new light copies (Review plays the full files). Default on.
STUDIO_LIGHT_COPIES=
# The home-screen app opens from its last copy of the page (a service worker; never data, sign-in
# or video). 0 = off: it removes itself from phones on their next open. Default on.
STUDIO_SERVICE_WORKER=

# ── The editor's cutting and framing (all on by default; 0 = off) ─────────────
# Jump cuts: pauses, breaths and lone "um"s inside what the editor keeps are cut down to a
# short breath when longer than STUDIO_EDIT_MAX_PAUSE seconds (default 0.7; pauses inside a sentence are kept)
STUDIO_EDIT_JUMP_CUTS=
STUDIO_EDIT_MAX_PAUSE=
# Horizontal footage (Z fc, GoPro) is cropped around your face instead of down the middle
STUDIO_EDIT_REFRAME=
# Punch-ins: talking shots cut between normal and a closer framing every 4-7 seconds
# (STUDIO_EDIT_PUNCH_ZOOM: how close, default 1.12 = 112%)
STUDIO_EDIT_PUNCH_INS=
STUDIO_EDIT_PUNCH_ZOOM=
# Drawn animations over the footage (motion library): where you explain something the footage
# doesn't show, or a shot is missing, the editor may lay a short animation over you while you keep
# talking (default on), at most STUDIO_EDIT_SCENES_MAX per draft (default 3)
STUDIO_EDIT_SCENES=
STUDIO_EDIT_SCENES_MAX=
# Pictures over the footage: where a real-looking thing explains it better than a drawing (a glass panel,
# a fluted panel, a terrazzo finish, a finished look), the editor may show an AI picture (Gemini, needs
# GEMINI_API_KEY above; marked "Concept"; about US$0.03 each) instead (default on), at most
# STUDIO_REEL_PICTURES_MAX new pictures a draft (default 4). Off, or no key: drawn animations instead.
STUDIO_REEL_PICTURES=
STUDIO_REEL_PICTURES_MAX=
# Words behind you: big words in the background that you stand in front of, for the hook or a key line on a
# talking shot (default on), at most STUDIO_EDIT_BEHIND_MAX a Reel (default 2, at most 2). Off: words on top.
STUDIO_EDIT_BEHIND=
STUDIO_EDIT_BEHIND_MAX=
# Studio fixes the editor-fixable points of its own read before you see a draft: up to this
# many rounds (default 2; 0 = off, every draft comes straight to review)
STUDIO_SELF_FIX_ROUNDS=
# Studio listens back to and watches through every finished Reel before you see it (words cut short
# or said twice, broken sentences, titles over your face, text gone too soon) and fixes what it finds
# in those rounds; free, no Claude (default on; 0 = off)
STUDIO_FINAL_CHECK=
# Slideshow Reels (a carousel's slides made into a Reel with music): each slide slowly grows a little
# while it's up, never cropped (default on; 0 = the slides stay still)
STUDIO_SLIDESHOW_PUSH_IN=
# Editing rules Studio teaches itself, in their own playbook section (0 = off), and at most
# how many per kind of post (default 20)
STUDIO_LEARN_RULES=
STUDIO_LEARNED_RULES_MAX=
# Caption font for the gallery and classic looks: inter (default), figtree, nunito, dm_sans or outfit
# (bundled in studio/render). Site Notes always uses its own font (Archivo).
STUDIO_CAPTION_FONT=
# The Reel's look (hook, captions, callouts, cards, end card): site (default: Site Notes, one bold font,
# words on dark labels, the key word in brass, graphics over the footage), gallery (the look before:
# a serif title with one italic word, captions glow with a key word in serif italic) or classic
# (the first look: boxed, amber bar). Going back is this one setting.
STUDIO_TITLE_STYLE=
# How far the music sits under your voice while you talk, in dB (default 20)
STUDIO_MUSIC_GAP_DB=
# Soft sound effects on the graphics (a whoosh as a label comes in, ticks on a numbers panel, a chime on the end
# card): Epidemic Sound's when its connection offers them, else Openverse's CC0 / public domain ones, fetched once
# (default on; 0 = voice and music only), how far under your voice in dB (default 24), at most how many a draft
# (default 5, and about one per 6 seconds)
STUDIO_SFX=
STUDIO_SFX_LEVEL_DB=
STUDIO_SFX_MAX=
# Words viewers read (captions, hooks, titles, slides): Studio always fixes invisible characters
# and typography (em dashes etc.); on (default), text that still reads machine-written gets one
# short Claude rewrite and the better version is kept. 0 = only the safe fixes.
# Trade terms the filter should never flag go in Studio/humanize_allow.txt, one per line.
STUDIO_HUMANIZE=

# ── Telegram (send-only, through Ava's bot) ───────────────────────────────────
# Same token as the bot's .env; chat ID = your numeric Telegram user ID
# (the value in the bot's ALLOWED_USER_IDS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard (review site) ───────────────────────────────────────────────────
# Everyone signs in (README section 8). Keep 127.0.0.1: Tailscale (or a Cloudflare
# Tunnel) reaches it on the laptop, so nothing on your network can connect directly.
STUDIO_DASHBOARD_HOST=127.0.0.1
STUDIO_DASHBOARD_PORT=8765
# The address the team opens, for Telegram links and invite links
# (from `tailscale serve`, e.g. https://your-laptop.tail1234.ts.net; README section 11)
STUDIO_DASHBOARD_URL=
# Check GitHub for a new version this often and update while idle (0 = off)
STUDIO_AUTO_UPDATE_MINUTES=10
# Reference reel downloads (the planner's References tab and worker.py --style-study): if
# Instagram asks for a login, use this browser's Instagram sign-in (chrome, edge, firefox).
# Leave blank otherwise.
STUDIO_YTDLP_COOKIES_BROWSER=

# ── Online planning (optional; README section 12) ─────────────────────────────
# Set these to plan on the online planner (Supabase + Netlify) instead of this
# dashboard's Plan tab. The worker then syncs with it about every 30 seconds.
# Supabase project URL (https://<ref>.supabase.co)
STUDIO_SUPABASE_URL=
# Supabase > Project Settings > API Keys: the secret key (sb_secret_...) or the legacy
# service_role key. It can read and change everything: keep it on this laptop only.
STUDIO_SUPABASE_SERVICE_KEY=
# The planner's address (the Netlify site), linked from the Plan tab
STUDIO_PLANNER_URL=
# Seconds between syncs (default 30)
STUDIO_CLOUD_SYNC_SECONDS=
# The planner's public key (anon or sb_publishable_...), for the planner at <dashboard>/plan/.
# Blank = Studio reads it once from the Netlify planner's config.js (STUDIO_PLANNER_URL).
STUDIO_SUPABASE_ANON_KEY=
# Other addresses whose planner may upload footage to a shot, comma-separated (the planner at
# STUDIO_PLANNER_URL and at <dashboard>/plan/ always may), e.g. https://deploy-preview-3--x.netlify.app
STUDIO_UPLOAD_ORIGINS=
# Ideas from new footage: minutes without a new clip before Claude suggests posts from a
# shoot day's uploads and adds them to the planned posts (default 20; 0 = off)
STUDIO_IDEAS_AFTER_MINUTES=
# Suggested topics: the day and hour (Singapore time) Studio suggests posts for the month's
# gaps each week (default monday, 8; off = only the planner's "Suggest topics" button), how many
# per run (default 4), and whether it also suggests when a kind falls behind past mid-month
# (default on; at most once a day). One Claude call per run, a few cents.
STUDIO_TOPICS_DAY=
STUDIO_TOPICS_HOUR=
STUDIO_TOPICS_COUNT=
STUDIO_TOPICS_BEHIND=
# Urban Makers' wiki as a source of topics (README "Ideas from the wiki"): the quote engine's
# Supabase address, a read-only role's token and the anon key (the CTO sets these on the server;
# never commit them). Blank = topics without the wiki.
STUDIO_WIKI_URL=
STUDIO_WIKI_JWT=
STUDIO_WIKI_ANON_KEY=
# After an update that adds online features, run once: python cloud_setup.py --update

# ── Accounts ──────────────────────────────────────────────────────────────────
# Who Studio makes content for. Blank = urban_makers only: every clip, idea and edit is
# Urban Makers (personal is on hold). urban_makers,personal brings the personal account back.
STUDIO_BRANDS=
# Who may sign in to the dashboard: emails at these domains, comma-separated. Blank =
# theurbanmakers.com; * = anyone. Owner accounts may always sign in.
STUDIO_ALLOWED_EMAIL_DOMAINS=

# ── OneDrive (on a server; server_move.py fills these in) ─────────────────────
# The OneDrive folder footage is uploaded to (a path inside OneDrive). Blank = off:
# on the laptop the inbox is the synced folder itself (STUDIO_INBOX).
STUDIO_ONEDRIVE_INBOX=
# Where picked-up originals move to, and where approved reels are copied (defaults below)
STUDIO_ONEDRIVE_ARCHIVE=
STUDIO_ONEDRIVE_READY=
# rclone remote name (default onedrive) and binary (default rclone)
STUDIO_ONEDRIVE_REMOTE=
STUDIO_RCLONE=

# ── Whisper ───────────────────────────────────────────────────────────────────
# auto = an NVIDIA GPU if one is attached, else the CPU (Intel Arc / AMD use the CPU)
WHISPER_DEVICE=auto
# Blank = large-v3-turbo on GPU, small on CPU. large-v3-turbo on CPU = more accurate, slower
WHISPER_MODEL=
# Blank = detect the language per clip, among WHISPER_LANGUAGES
WHISPER_LANGUAGE=
# Languages clips may be in (and subtitled in); blank = en,zh. Chinese is always Simplified.
WHISPER_LANGUAGES=

# ── ffmpeg (only if it's not on PATH) ─────────────────────────────────────────
FFMPEG_PATH=
FFPROBE_PATH=

# ── Reference library (bulk-imported references and the taste report) ────────
# Most Studio may spend a month on analysing them and writing taste reports, US$ (default 60;
# about 0.05 a post). Nothing is spent until the owner presses "Analyse" in the planner.
STUDIO_REFERENCE_BUDGET_USD=
# Library posts downloaded from Instagram an hour at most, spaced at random (default 4). Hand-added go first.
STUDIO_REFERENCE_LIBRARY_PER_HOUR=

# ── Posting to Instagram (README section 16) ─────────────────────────────────
# Studio posts only what Bryan approved and scheduled. The token, app ID and app secret are NOT set here:
# paste them in Review (account menu > Instagram); they're kept in Studio\instagram.json, this machine only.
# 0 = nothing goes out (scheduled posts wait).
STUDIO_POSTING=
# Posts a week the schedule suggests slots for (blank = the content plan's, default 3).
STUDIO_POSTS_PER_WEEK=
# The time of day (Singapore) a suggested slot starts at (default 19:30).
STUDIO_POST_TIME=
# Where Instagram fetches the files from while a post goes out (blank = STUDIO_DASHBOARD_URL; must be https).
STUDIO_PUBLIC_URL=
# Results are read every morning at this hour, Singapore (default 9).
STUDIO_RESULTS_HOUR=
# What kinds of posts work (insights.py): 0 turns it off. The Monday memo's day and hour, Singapore (default
# monday, 7: before the suggested topics), and its Claude model (blank = STUDIO_CLAUDE_MODEL; about US$0.10 a week).
STUDIO_INSIGHTS=
STUDIO_INSIGHTS_DAY=
STUDIO_INSIGHTS_HOUR=
STUDIO_INSIGHTS_MODEL=
# Most slides Instagram takes in a carousel (default 10).
STUDIO_INSTAGRAM_CAROUSEL_MAX=
# The handle on the animated explainers' end card (default urbanmakers_sg; the connected
# Instagram account's own name is used when there is one; off = none).
STUDIO_INSTAGRAM_HANDLE=
# The Graph API version (default v25.0) and address (tests only).
STUDIO_INSTAGRAM_API_VERSION=
STUDIO_INSTAGRAM_GRAPH_URL=

# ── Help, feedback and usage (help_desk.py, activity.py, usage_report.py) ──
# Ask Studio questions per person per day (default 30), and its model (default STUDIO_CLAUDE_MODEL).
STUDIO_HELP_DAILY=
STUDIO_HELP_MODEL=
# Usage capture in Review and the planner (never content); 0 = off. Kept this many days (default 180).
STUDIO_USAGE=
STUDIO_USAGE_DAYS=
