# Copy to studio\.env and fill in. Never commit .env.

# ── Folders ───────────────────────────────────────────────────────────────────
# Where the worker keeps the library, catalogue and logs (default: %USERPROFILE%\Studio)
STUDIO_ROOT=
# Where the phone's uploads land: the OneDrive folder, usually
#   C:\Users\<you>\OneDrive\Studio Inbox
# (Google Drive for desktop works too: G:\My Drive\Studio Inbox)
# Blank = %USERPROFILE%\Studio\Inbox
STUDIO_INBOX=

# ── Claude ────────────────────────────────────────────────────────────────────
# From console.anthropic.com (the same key the bot uses works)
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
STUDIO_CLAUDE_MODEL=claude-opus-5-5
STUDIO_CLAUDE_EFFORT=medium

# ── Epidemic Sound (music for the editor) ─────────────────────────────────────
# Personal MCP key: epidemicsound.com/account/api-keys
EPIDEMIC_SOUND_API_KEY=
# Accounts allowed to use Epidemic music: personal and/or urban_makers, comma-separated.
# Your plan covers one channel per platform, so list only the Instagram account you've
# connected in Epidemic Sound. Others get edits without Epidemic music.
STUDIO_MUSIC_ACCOUNTS=urban_makers

# ── Telegram (send-only, through Ava's bot) ───────────────────────────────────
# Same token as the bot's .env; chat ID = your numeric Telegram user ID
# (the value in the bot's ALLOWED_USER_IDS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard (review site) ───────────────────────────────────────────────────
# 127.0.0.1 = only this laptop. For your phone/desktop over Tailscale use 0.0.0.0
# AND set a password (it refuses to start otherwise).
STUDIO_DASHBOARD_HOST=127.0.0.1
STUDIO_DASHBOARD_PORT=8765
STUDIO_DASHBOARD_PASSWORD=
# The address you open it at, e.g. http://my-laptop:8765, so Telegram pings link to it
STUDIO_DASHBOARD_URL=

# ── Whisper ───────────────────────────────────────────────────────────────────
# auto = an NVIDIA GPU if one is attached, else the CPU (Intel Arc / AMD use the CPU)
WHISPER_DEVICE=auto
# Blank = large-v3-turbo on GPU, small on CPU. large-v3-turbo on CPU = more accurate, slower
WHISPER_MODEL=
# Blank = detect the language per clip
WHISPER_LANGUAGE=

# ── ffmpeg (only if it's not on PATH) ─────────────────────────────────────────
FFMPEG_PATH=
FFPROBE_PATH=
