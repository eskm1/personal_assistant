# Secrets for the Studio planning Edge Functions (plan-organise, plan-develop, team).
#
# Production: set them once with
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-... PLANNER_URL=https://<your-site>.netlify.app
# Supabase itself provides SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and
# SUPABASE_DB_URL to every function; don't set those.
#
# Local: copy to supabase/functions/.env (gitignored) and run
#   supabase functions serve --env-file supabase/functions/.env

# Required: the Anthropic API key Claude calls are billed to.
ANTHROPIC_API_KEY=

# Optional: another Messages API endpoint (tests point this at tests/mock_anthropic.py,
# e.g. http://host.docker.internal:8787 from the local edge runtime container).
ANTHROPIC_BASE_URL=

# Optional: where invite emails land when the planner doesn't send redirect_to
# (must also be in Auth > URL Configuration > Redirect URLs).
PLANNER_URL=

# Optional: restrict CORS to the planner's origin (default "*"; the functions use bearer
# tokens, not cookies).
ALLOWED_ORIGIN=
